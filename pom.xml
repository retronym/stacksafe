<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.retronym</groupId>
  <artifactId>stacksafe</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>stacksafe</name>
  <description>Bytecode transform that moves deep recursion off the thread stack using jdk.internal.vm.Continuation</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <asm.version>9.10.1</asm.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-tree</artifactId>
      <version>${asm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <!-- *IT classes need the packaged agent jar; they run in the agent-it execution below. -->
          <excludes><exclude>**/*IT.java</exclude></excludes>
        </configuration>
        <executions>
          <!-- The same suite again on the internal-API backend. -->
          <execution>
            <id>continuation-backend</id>
            <phase>test</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <argLine>--add-exports java.base/jdk.internal.vm=ALL-UNNAMED</argLine>
              <systemPropertyVariables>
                <stacksafe.backend>continuation</stacksafe.backend>
              </systemPropertyVariables>
              <reportNameSuffix>continuation</reportNameSuffix>
            </configuration>
          </execution>
          <!-- End-to-end: forks a JVM with -javaagent on the shaded jar. Runs after package. -->
          <execution>
            <id>agent-it</id>
            <phase>verify</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <excludes combine.self="override"/>
              <includes><include>**/*IT.java</include></includes>
              <systemPropertyVariables>
                <stacksafe.agentJar>${project.build.directory}/${project.build.finalName}.jar</stacksafe.agentJar>
              </systemPropertyVariables>
              <reportNameSuffix>agent-it</reportNameSuffix>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Single self-contained agent jar: ASM is shaded so the agent cannot clash with application classpaths. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>org.objectweb.asm</pattern>
                  <shadedPattern>stacksafe.shaded.asm</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Premain-Class>stacksafe.StackSafeAgent</Premain-Class>
                    <Agent-Class>stacksafe.StackSafeAgent</Agent-Class>
                    <Can-Redefine-Classes>false</Can-Redefine-Classes>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
